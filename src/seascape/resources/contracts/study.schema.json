{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marinecast:study-config:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "bbox_wgs84": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "boundary_semantics": {
          "const": "longitude_latitude_rectangle"
        },
        "offshore_minimum_nm": {
          "type": "number",
          "minimum": 12
        },
        "nautical_mile_m": {
          "const": 1852
        },
        "water_membership": {
          "const": "positive_area_intersection_with_validated_marine_mask"
        },
        "land_sources": {
          "type": "string"
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "source_message_id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "const": "rectangular_selection_only"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "approved_at",
            "source_message_id",
            "scope",
            "statement"
          ],
          "additionalProperties": false
        },
        "revision_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "status",
        "crs",
        "bbox_wgs84",
        "boundary_semantics",
        "offshore_minimum_nm",
        "nautical_mile_m",
        "water_membership",
        "land_sources",
        "geometry_sha256"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end_exclusive": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "const": "UTC"
        },
        "daily_interval": {
          "const": "[start,end)"
        },
        "availability_policy": {
          "const": "retain_requested_window_report_actual_source_coverage_and_as_of"
        }
      },
      "required": [
        "start",
        "end_exclusive",
        "timezone",
        "daily_interval",
        "availability_policy"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "data_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "data_root"
      ],
      "additionalProperties": false
    },
    "products": {
      "type": "object",
      "properties": {
        "seascape": {
          "type": "object",
          "properties": {
            "h3_resolution": {
              "const": 6
            },
            "retain_native": {
              "const": true
            }
          },
          "required": [
            "h3_resolution",
            "retain_native"
          ],
          "additionalProperties": false
        },
        "viewshed": {
          "type": "object",
          "properties": {
            "h3_resolution": {
              "const": 7
            },
            "retain_native": {
              "const": true
            }
          },
          "required": [
            "h3_resolution",
            "retain_native"
          ],
          "additionalProperties": false
        },
        "meteorology": {
          "type": "object",
          "properties": {
            "h3_resolution": {
              "const": 5
            },
            "retain_native": {
              "const": true
            }
          },
          "required": [
            "h3_resolution",
            "retain_native"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seascape",
        "viewshed",
        "meteorology"
      ],
      "additionalProperties": false
    },
    "producer_buffers": {
      "type": "object",
      "properties": {
        "seascape": {
          "type": "object",
          "properties": {
            "water_geometry_m": {
              "type": "number",
              "minimum": 0
            },
            "coastal_network_m": {
              "type": "number",
              "minimum": 0
            },
            "freshwater_context_m": {
              "type": "number",
              "minimum": 0
            },
            "river_source_context_m": {
              "type": "object",
              "properties": {
                "bc": {
                  "type": "number",
                  "minimum": 0
                },
                "us": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "bc",
                "us"
              ],
              "additionalProperties": false
            },
            "catchment_context_m": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "water_geometry_m",
            "coastal_network_m",
            "freshwater_context_m",
            "river_source_context_m",
            "catchment_context_m"
          ],
          "additionalProperties": false
        },
        "viewshed": {
          "type": "object",
          "properties": {
            "line_of_sight_m": {
              "type": "number",
              "minimum": 0
            },
            "aoi_margin_m": {
              "type": "number",
              "minimum": 0
            },
            "source_policy": {
              "type": "string"
            },
            "native_raster_policy": {
              "type": "string"
            }
          },
          "required": [
            "line_of_sight_m",
            "aoi_margin_m",
            "source_policy",
            "native_raster_policy"
          ],
          "additionalProperties": false
        },
        "meteorology": {
          "type": "object",
          "properties": {
            "native_grid_policy": {
              "type": "string"
            },
            "legacy_bbox_padding_degrees": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "native_grid_policy",
            "legacy_bbox_padding_degrees"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seascape",
        "viewshed",
        "meteorology"
      ],
      "additionalProperties": false
    },
    "grid_registry": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending_validated_marine_mask",
            "validated"
          ]
        },
        "h3_resolutions": {
          "const": [
            5,
            6,
            7
          ]
        },
        "membership_policy": {
          "const": "positive_area_intersection"
        },
        "cell_id_type": {
          "const": "lowercase_h3_string"
        },
        "mask_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "mask_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resolution": {
                "enum": [
                  5,
                  6,
                  7
                ]
              },
              "role": {
                "enum": [
                  "rectangle",
                  "water_reporting",
                  "land_source",
                  "water_source"
                ]
              },
              "relative_path": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "resolution",
              "role",
              "relative_path",
              "count",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "h3_resolutions",
        "membership_policy",
        "cell_id_type",
        "mask_revision",
        "mask_sha256",
        "memberships"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "domain",
    "time",
    "storage",
    "products",
    "producer_buffers",
    "grid_registry"
  ],
  "additionalProperties": false
}
