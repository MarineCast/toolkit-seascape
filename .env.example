# Seascape workspace settings. Process environment values take precedence.
# WGS84 decimal degrees: southwest = MIN_LON, MIN_LAT; northeast = MAX_LON, MAX_LAT.
# Preserve distinct model, processing-context and source-acquisition extents.
SEASCAPE_MODEL_MIN_LON=-125.80
SEASCAPE_MODEL_MIN_LAT=46.85
SEASCAPE_MODEL_MAX_LON=-121.60
SEASCAPE_MODEL_MAX_LAT=50.00

SEASCAPE_EXTENDED_MIN_LON=-132.00
SEASCAPE_EXTENDED_MIN_LAT=44.00
SEASCAPE_EXTENDED_MAX_LON=-121.00
SEASCAPE_EXTENDED_MAX_LAT=52.00

SEASCAPE_SOURCE_MIN_LON=-180.00
SEASCAPE_SOURCE_MIN_LAT=32.00
SEASCAPE_SOURCE_MAX_LON=-109.00
SEASCAPE_SOURCE_MAX_LAT=72.00

# Current configured public sources require no user API tokens.
# Optional protected HTTP source: set bearer_token_env: SEASCAPE_HTTP_BEARER_TOKEN
# on that source's YAML entry. Sent only to explicitly configured HTTPS sources.
SEASCAPE_HTTP_BEARER_TOKEN=
